{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "rootDir": ".",
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["*"]
    }
  },
  "include": [
    "server.mjs",
    "lib/**/*.mjs",
    "electron/**/*.mjs",
    "public/**/*.mjs",
    "scripts/**/*.mjs",
    "types/**/*.d.ts",
    "types/**/*.ts",
    "*.mjs"
  ],
  "exclude": ["node_modules", "dist", "tools", "remotion-splash"]
}
